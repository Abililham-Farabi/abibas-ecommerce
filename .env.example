# Contoh konfigurasi environment (SERVER-SIDE, jangan pakai prefix VITE_)
# Salin ke .env untuk pengembangan lokal yang memakai backend sungguhan.
# JANGAN menulis secret asli di file ini atau di repo publik.

APPS_SCRIPT_URL=https://script.google.com/macros/s/PASTE_DEPLOYMENT_ID_ANDA/exec
APPS_SCRIPT_SHARED_SECRET=isi_dengan_string_acak_panjang_min_32_karakter

# Mode data frontend (tanpa prefix rahasia, aman untuk browser):
# demo   -> data lokal berlabel simulasi, tanpa backend
# sheets -> memanggil /api/* yang membutuhkan dua variabel di atas
VITE_DATA_MODE=demo
